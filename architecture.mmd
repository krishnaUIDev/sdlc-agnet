graph TD
    classDef default fill:#1e1e1e,stroke:#333,stroke-width:1px,color:#fff;
    classDef human fill:#444,stroke:#666,color:#fff,rx:8px,ry:8px;
    classDef db fill:#b35900,stroke:#e67300,color:#fff,rx:8px,ry:8px,font-weight:bold;
    classDef manager fill:#4b3b8c,stroke:#5c4b9e,color:#fff,rx:8px,ry:8px;
    classDef scrum fill:#005f73,stroke:#003f4c,color:#fff,rx:8px,ry:8px;
    classDef worker fill:#1c5e46,stroke:#24785a,color:#fff,rx:8px,ry:8px;
    classDef review fill:#8c3a26,stroke:#a3442d,color:#fff,rx:8px,ry:8px;
    classDef devops fill:#7e3e98,stroke:#5c2d70,color:#fff,rx:8px,ry:8px;
    classDef monitor fill:#a32a2a,stroke:#c43333,color:#fff,rx:8px,ry:8px;

    User["User / Human<br/>Sets Goal"]:::human
    
    DB[("Supabase DB + Realtime (Pub/Sub)<br/>State: PENDING → ASSIGNED → IN_PROGRESS → COMPLETED/REJECTED")]:::db

    Watcher["SLA / Timeout Monitor<br/>Flags stuck tasks"]:::monitor

    Jarvis["Jarvis — Manager Agent"]:::manager
    ScrumMaster["Scrum Master Agent"]:::scrum

    UX["UX Design Agent"]:::worker
    Dev["Developer Agent"]:::worker
    SEO["SEO Agent"]:::worker
    Security["Security Agent"]:::worker
    QA["QA / Testing Agent"]:::worker

    HelpAgent["Help / Resolution Agent<br/>(Unblocks stuck agents)"]:::manager
    Review["Review Agent<br/>(Quality Gate)"]:::review
    DevOps["DevOps Agent"]:::devops
    Finished["Deployed Application"]:::human
    Rollback["Previous Version<br/>(Rollback Target)"]:::human

    %% Communication Flow: Event Bus / Pub/Sub
    User -->|1. Creates Epic| DB
    DB -.->|Pub/Sub Event| Watcher
    
    DB -.->|Event: New Epic| Jarvis
    Jarvis -->|Updates Epic Status| DB
    
    DB -.->|Event: Epic Breakdown| ScrumMaster
    ScrumMaster -->|Creates Sub-tasks| DB

    %% Task Execution & Pub/Sub Assignment
    DB -.->|Event: Task PENDING| UX
    DB -.->|Event: Task PENDING| Dev
    DB -.->|Event: Task PENDING| SEO
    DB -.->|Event: Task PENDING| Security
    DB -.->|Event: Task PENDING| QA

    %% Dependencies
    Dev -.->|Waits for| UX
    QA -.->|Waits for| Dev
    Security -.->|Waits for| Dev
    Review -.->|Waits for| QA & Security & SEO

    UX -->|Submits Work| DB
    Dev -->|Submits Work| DB
    SEO -->|Submits Work| DB
    Security -->|Submits Work| DB
    QA -->|Submits Work| DB

    DB -.->|Event: NEEDS_HELP| HelpAgent
    HelpAgent -->|Provides Answer, resets to PENDING| DB

    DB -.->|Event: Tasks COMPLETED| Review
    Review -->|"Approves"| DB
    Review -->|"REJECTS (Sets status REJECTED)"| DB
    DB -.->|Event: REJECTED (Reassigns)| Dev

    DB -.->|Event: APPROVED| DevOps
    DevOps -->|"Merges & Deploys"| Finished
    DevOps -.->|"Fails Deployment"| Rollback
